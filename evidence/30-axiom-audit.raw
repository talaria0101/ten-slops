@MetricCodes.Spherical.HigherHierarchy.strict_hierarchy : ∀ {s : ℝ},
  0 < s →
    s < 1 →
      (∀ (r : ℕ),
          MetricCodes.Spherical.HigherHierarchy.levelRate (r + 1) s <
              MetricCodes.Spherical.HigherHierarchy.levelRate r s ∧
            MetricCodes.Spherical.HigherHierarchy.localizedLevelRate (r + 1) s <
              MetricCodes.Spherical.HigherHierarchy.localizedLevelRate r s) ∧
        MetricCodes.Spherical.HigherHierarchy.sphericalCodeRate s ≤
            MetricCodes.Spherical.HigherHierarchy.localizedHierarchyRate s ∧
          MetricCodes.Spherical.HigherHierarchy.localizedHierarchyRate s <
              MetricCodes.Spherical.HigherHierarchy.localizedLevelRate 1 s ∧
            MetricCodes.Spherical.HigherHierarchy.localizedLevelRate 1 s <
                MetricCodes.Spherical.HigherHierarchy.localizedRowRate s ∧
              MetricCodes.Spherical.HigherHierarchy.localizedRowRate s <
                  MetricCodes.Spherical.HigherHierarchy.localizedLevelRate 0 s ∧
                MetricCodes.Spherical.HigherHierarchy.localizedLevelRate 0 s =
                  MetricCodes.Spherical.HigherHierarchy.classicalLocalizedRate s
'MetricCodes.Spherical.HigherHierarchy.strict_hierarchy' depends on axioms: [propext, Classical.choice, Quot.sound]
@PermanentFormulaLowerBound.permanent_rational_formula_logarithmic_lower_bound : ∀ {n : ℕ},
  32 ≤ n →
    ∀ (f : PermanentFormulaLowerBound.RationalFormula (Fin n × Fin n) ℂ),
      f.Valid →
        f.eval =
            (algebraMap (MvPolynomial (Fin n × Fin n) ℂ) (FractionRing (MvPolynomial (Fin n × Fin n) ℂ)))
              (PermanentFormulaLowerBound.permanentPolynomial n) →
          ↑n ^ 4 / (192 * Real.logb 2 ↑n) ≤ ↑f.variableLeaves
'PermanentFormulaLowerBound.permanent_rational_formula_logarithmic_lower_bound' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
