ConnesRigidity.exists_infinite_pairwise_nonisomorphic_propertyT_icc_groups_with_isomorphic_factors : ∃ Λ Γ,
  Group.FG Λ.Carrier ∧
    (∀ (n : ℕ), Group.FG (Γ n).Carrier) ∧
      ConnesRigidity.IsICC Λ ∧
        (∀ (n : ℕ), ConnesRigidity.IsICC (Γ n)) ∧
          ConnesRigidity.HasKazhdanPropertyT Λ ∧
            (∀ (n : ℕ), ConnesRigidity.HasKazhdanPropertyT (Γ n)) ∧
              (∀ (n : ℕ), ConnesRigidity.TracialGroupFactorsIsomorphic (Γ n) Λ) ∧
                (∀ (m n : ℕ), ConnesRigidity.TracialGroupFactorsIsomorphic (Γ m) (Γ n)) ∧
                  (∀ ⦃m n : ℕ⦄, m ≠ n → ¬ConnesRigidity.GroupsIsomorphic (Γ m) (Γ n)) ∧
                    ∀ (n : ℕ), ¬ConnesRigidity.GroupsIsomorphic Λ (Γ n)
