  Filter.Tendsto (fun k => ↑(ErdosProblems.MulticolourTriangleRamsey.triangleRamseyNumber k) ^ (1 / ↑k)) Filter.atTop
    Filter.atTop
'ErdosProblems.MulticolourTriangleRamsey.erdos_problem_183_explicit' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
CompactnessConjecture.quantitativeCompactnessCounterexample : ∃ family c C,
  family.Nonempty ∧
    (∀ forbidden ∈ family, forbidden.graph.Connected ∧ forbidden.graph.IsBipartite ∧ ¬forbidden.graph.IsAcyclic) ∧
      0 < c ∧
        0 < C ∧
          CompactnessConjecture.UniformMemberLower family c ∧
            (∀ (n : ℕ) (host : SimpleGraph (Fin n)),
                CompactnessConjecture.FamilyFree family host → ↑host.edgeFinset.card ^ 16 ≤ C * ↑n ^ 21) ∧
              (∀ (n : ℕ), ↑(CompactnessConjecture.familyExtremal family n) ^ 16 ≤ C * ↑n ^ 21) ∧
                0 < 1 / 48 ∧
                  21 / 16 = 4 / 3 - 1 / 48 ∧
                    ¬CompactnessConjecture.IsCompactFamily family ∧
                      ¬CompactnessConjecture.CompactnessConjectureStatement
'CompactnessConjecture.quantitativeCompactnessCounterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
TwoDegenerateGraphs.twoDegenerateExtremalCounterexample : ∃ q H,
  H.Connected ∧
    H.IsBipartite ∧
      TwoDegenerateGraphs.IsTwoDegenerate H ∧
        (∀ (coloring : H.Coloring (Fin 2)) (side : Fin 2),
            2 < {vertex | coloring vertex = side}.sup fun vertex => H.degree vertex) ∧
          ∃ c ε, 0 < c ∧ 0 < ε ∧ ∀ᶠ (n : ℕ) in Filter.atTop, c * ↑n ^ (3 / 2 + ε) ≤ ↑(SimpleGraph.extremalNumber n H)
'TwoDegenerateGraphs.twoDegenerateExtremalCounterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
