@Ehrhart.Volume.ehrhart_volume_inequality_for_sets : ∀ {n : ℕ},
  0 < n →
    ∀ (S : Set (Ehrhart.Space n)),
      Convex ℝ S →
        IsCompact S →
          (interior S).Nonempty →
            Ehrhart.barycenter S = 0 →
              Ehrhart.interiorLatticePoints S = {0} → Ehrhart.normalizedVolume S ≤ (↑n + 1) ^ n / ↑n.factorial
'Ehrhart.Volume.ehrhart_volume_inequality_for_sets' depends on axioms: [propext, Classical.choice, Quot.sound]
QuantumParallelRepetition.distributionUniformExponential : ∃ c,
  0 < c ∧
    ∀ {X Y A B : Type} [inst : Fintype X] [inst_1 : Fintype Y] [inst_2 : Fintype A] [inst_3 : Fintype B]
      (G : QuantumParallelRepetition.Game X Y A B),
      Nonempty A →
        Nonempty B →
          0 < 1 - QuantumParallelRepetition.entangledValue G →
            ∀ (n : ℕ),
              0 < n →
                QuantumParallelRepetition.repeatedEntangledValue G n ≤
                  Real.exp
                    (-(c *
                          ((1 - QuantumParallelRepetition.entangledValue G) ^ 13 /
                            (1 - QuantumParallelRepetition.entangledValue G +
                              Real.log (↑(Fintype.card A) * ↑(Fintype.card B))))) *
                      ↑n)
'QuantumParallelRepetition.distributionUniformExponential' depends on axioms: [propext, Classical.choice, Quot.sound]
