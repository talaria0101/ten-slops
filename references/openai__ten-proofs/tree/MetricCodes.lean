        P * (C * J) + (J * P) * C := by noncomm_ring
    _ = P * (C * J) + (P * J) * C := by rw [← hcomm]
    _ = P * (C * J + J * C) := by noncomm_ring
    _ = P * (if δ = γ then Cβ * Cα else 0) := by rw [hcar]
    _ = _ := by split_ifs with h <;> simp [h, P]

