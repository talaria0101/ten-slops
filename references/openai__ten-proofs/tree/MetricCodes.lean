      congrArg (fun U : AdmissibleRootWedge lam (k + 1) => U.val.val) hS
    apply Subtype.ext
    apply Subtype.ext
    change T.val.val = S.val.val.erase α
    rw [← hset, Finset.erase_insert hα]
