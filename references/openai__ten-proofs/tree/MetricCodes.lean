  let B := normalizedGTTransversePositiveSector
    lam mu nu row hmunu h hnu hnuGram
  let T := gtRelativeCasimir (n := n + 1) lam
  let node := gtStabilizerArrowheadNode (wallShift (n + 1) (r + 1))
    (stabilizerShift (n + 1) mu) (.inr (row, true))
