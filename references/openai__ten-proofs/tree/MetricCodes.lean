        (oddCoordinate hn j) (youngComplexPair nu (A p) (A q)) +
      Complex.I • complexAmbientRotation (r := r)
        (oddCoordinate hn i) (evenCoordinate hn j)
          (youngComplexPair nu (A p) (A q)) +
      Complex.I • complexAmbientRotation (r := r)
        (oddCoordinate hn j) (evenCoordinate hn i)
