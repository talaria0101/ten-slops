      orthogonalTensorPieriCoefficient n
        (((lam i : ℤ) - (i.val : ℤ)) - 1) (j.val : ℤ)

def orthogonalTensorPieriNextColumn {r : ℕ} (n : ℕ)
    (lam : Fin (r + 1) → ℕ) (j : Fin (r + 1)) : Fin (r + 1) → ℤ :=
