    _ = (E * P) * (Cβ * Cα) := by rw [hE]
    _ = E * (P * Cβ) * Cα := by noncomm_ring
    _ = E * (Cβ * P) * Cα := by rw [hβ]
    _ = E * Cβ * (P * Cα) := by noncomm_ring
    _ = E * Cβ * (Cα * P) := by rw [hα]
