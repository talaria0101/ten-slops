        Fintype.card_fin, Fintype.card_bool] <;> omega
  · exact hroot

theorem gtAxisCompressedCharacteristicMinor_eq_channelNumerator_of_roots
    {r n : ℕ} (lam : Fin (r + 2) → ℕ)
    (mu : Fin (r + 1) → ℕ) (h : Interlaces lam mu)
