      lam mu nu row hmunu h hnu hnuGram
  have hclosed (x : HarmonicYoungSpace (n := n) mu) :
      T (B x) ∈ LinearMap.range A.toLinearMap ⊔
        LinearMap.range B.toLinearMap :=
    gtTransversePositiveSector_relativeCasimir_mem_axis_sup_sector
