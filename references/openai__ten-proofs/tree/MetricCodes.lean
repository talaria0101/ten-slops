  have hlast' : j < MetricCodes.johnsonLastDegree n w 0 0 := by
    simpa [hlast] using hjw
  unfold MetricCodes.johnsonZonalEdge
  rw [johnsonEdge_sq_factored hz hstrict (Nat.zero_le j) hlast']
