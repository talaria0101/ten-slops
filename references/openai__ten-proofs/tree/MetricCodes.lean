        positiveRootUpperOperator n α
          (positiveRootOperator n β
            (((f (rootAdmissibleSwap lam S α β hα hβ hadm)).val :
              youngMultihomogeneousSubmodule n
                (rootWedgeWeight lam
                  (rootAdmissibleSwap lam S α β hα hβ hadm))) :
              PolynomialSpace r n)) := by
