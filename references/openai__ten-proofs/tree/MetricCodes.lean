  classical
  by_cases hα : α ∈ S.val.val
  · simp [rootPolynomialActionDifferentialCoboundaryIncidence, hα]
  · by_cases hpos : 0 < rootWedgeWeight lam S (positiveRootSecond α)
    · have hins : ∀ i,
