theorem gtAxisCompressedSignedProjectorCoefficient_last_false_eq_zero
    {r n : ℕ} (hn : 2 * (r + 1) + 4 ≤ n + 1)
    (lam : Fin (r + 2) → ℕ) (mu : Fin (r + 1) → ℕ)
    (h : Interlaces lam mu)
    (hgram : PositiveGelfandTsetlinFischerGram (n := n) lam mu h)
