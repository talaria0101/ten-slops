  have hraw := sum_det_updateRow_orthogonalTensorPieriSignedShiftMatrix
    n lam hzero
  rw [hsplit,
    sum_det_updateRow_raise_eq_dominant_subtype n lam hdom,
    sum_det_updateRow_lower_eq_positive_dominant_subtype n lam hdom] at hraw
  exact hraw

