          Real.sqrt (clebschNormSq w (n - w) p q (t + 1))) *
        MetricCodes.Boolean.dot f (coupledHarmonic x hp hq a (t + 1)) := by
  rw [johnsonAxisRaise_coupledHarmonic_dot
