theorem johnsonOffDiagonal_fourthPower_grouped_algebra
    {N W C G j A B E F : ℝ}
    (hN : N ≠ 0) (hW : W ≠ 0) (hC : C ≠ 0)
    (hWj : W - j ≠ 0) (hCj : C - j ≠ 0)
    (hG : G ≠ 0) (hGminus : G - 1 ≠ 0)
    (hGplus : G + 1 ≠ 0) (hjone : j + 1 ≠ 0)
    (hlast : N - j + 1 ≠ 0) :
    (N * A * B * E * F) ^ 2 /
        (W * C * G * (G + 1)) ^ 2 / (j + 1) ^ 2 =
      (((N ^ 2 *
          ((W - j) * (C - j) * A * B * E * F)) /
          ((W * C) ^ 2 * G ^ 2 * ((G - 1) * (G + 1)))) ^ 2 /
        ((N ^ 2 *
            ((W - j) ^ 2 * (C - j) ^ 2 *
              (j + 1) * (N - j + 1))) /
          ((W * C) ^ 2 * G ^ 2 * ((G - 1) * (G + 1))))) *
        (((G - 1) * (N - j + 1)) /
          ((j + 1) * (G + 1))) := by
  field_simp [hN, hW, hC, hWj, hCj, hG,
    hGminus, hGplus, hjone, hlast]

theorem johnsonAdjacentRawSquare_compact_algebra
    {N W C P Q T : ℝ}
    (hNC : N = W + C)
    (hW : W ≠ 0) (hC : C ≠ 0)
    (hgap : N - 2 * (P + Q + T) ≠ 0)
    (hgapplus : N - 2 * (P + Q + T) + 1 ≠ 0) :
    (N / (W * C)) *
        ((T + 1) * (C - 2 * Q - T)) *
        ((((W - 2 * P) + (C - 2 * Q) - T + 1) *
            (W - 2 * P - T)) /
          (((W - 2 * P) + (C - 2 * Q) - 2 * T + 1) *
            ((W - 2 * P) + (C - 2 * Q) - 2 * T))) =
      (N * (W - (P + Q + T) - P + Q) *
        (C - (P + Q + T) + P - Q) *
        ((P + Q + T) - P - Q + 1) *
        (N - P - Q - (P + Q + T) + 1)) /
        (W * C * (N - 2 * (P + Q + T)) *
          (N - 2 * (P + Q + T) + 1)) := by
  let j : ℝ := P + Q + T
  let G : ℝ := N - 2 * j
  have hG : G ≠ 0 := hgap
  have hGone : G + 1 ≠ 0 := hgapplus
  have hden :
      ((W - 2 * P) + (C - 2 * Q) - 2 * T) = G := by
    dsimp [G, j]
    rw [hNC]
    ring
  have hdenone :
      ((W - 2 * P) + (C - 2 * Q) - 2 * T + 1) = G + 1 := by
    rw [hden]
  rw [hdenone, hden]
  change
    (N / (W * C)) *
        ((T + 1) * (C - 2 * Q - T)) *
        ((((W - 2 * P) + (C - 2 * Q) - T + 1) *
            (W - 2 * P - T)) / ((G + 1) * G)) =
      (N * (W - j - P + Q) * (C - j + P - Q) *
        (j - P - Q + 1) * (N - P - Q - j + 1)) /
        (W * C * G * (G + 1))
  field_simp [hW, hC, hG, hGone]
  dsimp [j]
  rw [hNC]
  ring

end

