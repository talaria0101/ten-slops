def twoRowJointHarmonicSubmodule (n i j : ℕ) :
    Submodule ℝ (youngMultihomogeneousSubmodule n ![i, j]) :=
  (traceFreeSubmodule 1 n).comap
    (youngMultihomogeneousSubmodule n ![i, j]).subtype

abbrev TwoRowJointHarmonicSpace (n i j : ℕ) :=
  ↥(twoRowJointHarmonicSubmodule n i j)

def twoRowJointHarmonicHomogeneousEmbedding (n i j : ℕ) :
    TwoRowJointHarmonicSpace n i j →ₗ[ℝ]
      SpherePacking.Fischer.Homogeneous (2 * n) (i + j) where
  toFun p := ⟨(p.val : PolynomialSpace 1 n), by
    simpa [Fin.sum_univ_succ] using
      (youngMultihomogeneous_isHomogeneous ![i, j] p.val)⟩
  map_add' p q := by
    apply Subtype.ext
    rfl
  map_smul' c p := by
    apply Subtype.ext
    rfl

theorem twoRowJointHarmonicHomogeneousEmbedding_injective
    (n i j : ℕ) :
    Function.Injective (twoRowJointHarmonicHomogeneousEmbedding n i j) := by
  intro p q h
  apply Subtype.ext
  apply Subtype.ext
  exact congrArg
    (fun z : SpherePacking.Fischer.Homogeneous (2 * n) (i + j) =>
      (z : PolynomialSpace 1 n)) h

instance twoRowJointHarmonicSpace_finiteDimensional
    (n i j : ℕ) :
    FiniteDimensional ℝ (TwoRowJointHarmonicSpace n i j) :=
  FiniteDimensional.of_injective
    (twoRowJointHarmonicHomogeneousEmbedding n i j)
    (twoRowJointHarmonicHomogeneousEmbedding_injective n i j)

end

