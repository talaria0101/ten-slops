    shortRoot_unusedDerivative_sum_eq_card_smul_of_rootKernel
      h b p f (fun t ht => hroots (.short p t ht))
  rw [shortRoot_mixedRemainder_eq_neg_rowDerivation_add_isotropic_traces
        h lam hf b p] at henergy
  have hdouble :
      (∑ q : Fin (r + 1),
        ∑ a : Fin (r + 1),
