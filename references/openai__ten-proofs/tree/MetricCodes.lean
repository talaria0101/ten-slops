  intro w
  calc
    ⟪w, (normalizedYoungClebschRaise mu lam hdeg row c hc hgram).adjoint
        (v ⊗ₜ[ℝ] q)⟫_ℝ =
      ⟪normalizedYoungClebschRaise mu lam hdeg row c hc hgram w,
