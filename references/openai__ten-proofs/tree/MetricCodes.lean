    (f : MvPolynomial (Fin ((r + 1) * n)) ℂ)
    (p : Fin (r + 1)) :
    ambientCartan h p (ambientSignedWeightComponent h mu f) =
      ((2 : ℂ) * (mu p : ℂ)) • ambientSignedWeightComponent h mu f := by
  unfold ambientSignedWeightComponent
