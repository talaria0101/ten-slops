            simpa [Fin.tail] using h.2 i.succ.succ

def hierarchyStieltjesRatio {r : ℕ}
    (a : Fin (r + 1) → ℝ) (b : Fin r → ℝ) (t : ℝ) : ℝ :=
  (∏ i : Fin r, (t + quadraticCoordinate (b i))) /
    (∏ i : Fin (r + 1), (t + quadraticCoordinate (a i)))

theorem hierarchyStieltjesRatio_prepend {r : ℕ}
    (a : Fin (r + 1) → ℝ) (b : Fin r → ℝ)
    (u v t : ℝ) :
