    (le_of_eq
      (gtTransverseTensorEmbedding_range_eq_selectedFull
        lam nu hnu hn hnu.antitone_ambient hnuGram).symm)
    (gtRelativeCasimir (n := n + 1) lam)
    (normalizedGTTransversePositiveSector
