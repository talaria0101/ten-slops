theorem neg_add_inv_sub_smul_eq_neg_div_smul
    {V : Type*} [AddCommGroup V] [Module ℝ V]
    (x y : ℝ) (hy : y ≠ 0) (v : V) :
    -v + y⁻¹ • ((y - x) • v) = -(x / y) • v := by
  rw [smul_smul, ← neg_one_smul ℝ v, ← add_smul]
  congr 1
  field_simp [hy]
  ring

end HigherYoungDownstreamAdjacentCancellationAlgebra

