  rw [Finset.sum_eq_single (Fin.last r)]
  · rw [orthogonalTensorPieriSignedShiftMatrix_column,
      Matrix.det_updateCol_add,
      det_updateCol_orthogonalTensorPieriPrevColumn_eq_zero,
      add_zero]
  · intro j _ hj
