theorem youngRotationIntertwiner_eq_zero_of_signature_ne
    {r n : ℕ} (hstable : 2 * (r + 1) + 2 ≤ n)
    (mu nu : Fin (r + 1) → ℕ) (hmu : Antitone mu)
    (hne : mu ≠ nu)
    (A : HarmonicYoungSpace (n := n) mu →ₗ[ℝ]
