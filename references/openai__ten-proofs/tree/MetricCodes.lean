    Phi a b = Phi (Fin.tail a) (Fin.tail b) := by
  conv_lhs =>
    rw [← Fin.cons_self_tail a, ← Fin.cons_self_tail b]
  change Phi (prependAmbient (a 0) (Fin.tail a))
    (prependStabilizer (b 0) (Fin.tail b)) = _
  rw [Phi_prepend]
  simp [hcollision]

