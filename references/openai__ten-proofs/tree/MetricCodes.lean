theorem axialTransverseRetraction_rowPairingPolynomial_last_left
    {r n : ℕ} (j : Fin (r + 2)) :
    axialTransverseRetraction
      (rowPairingPolynomial (r := r + 1) (n := n + 1)
        (Fin.last (r + 1)) j) = (0 : PolynomialSpace r n) := by
