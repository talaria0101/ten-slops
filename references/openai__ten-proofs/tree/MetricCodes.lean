    exact actualPositiveRootHighestRigidity_metriccodes2_459a111e hn hstable mu hz hroots

theorem canonicalGelfandTsetlinFibre_crossGram_rotation_intertwine
    {r n : ℕ} (lam : Fin (r + 2) → ℕ)
    (mu nu : Fin (r + 1) → ℕ)
