def weightedExteriorRootEdgeAdjointAt {r k : ℕ}
    (n : ℕ) (lam : Fin (r + 1) → ℕ)
    (T : AdmissibleRootWedge lam k)
    (α : PositiveRoot r) (hα : α ∉ T.val.val)
