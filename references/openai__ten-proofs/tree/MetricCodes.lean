  intro r m n a b hinterlacing hlast hn hstable
  obtain ⟨o, fibre, hwitness⟩ :=
    hrealization a b hinterlacing hlast hn hstable
  exact ⟨boxRepresentationData_of_projectedAxisWitnesses a b hstable
    (fun lam hd hdom =>
