theorem levelRateSet_nonempty_of_mem_source_interval
    {r : ℕ} {s t : ℝ}
    (hs : 0 < s) (hs' : s < 1) (hts : t ≤ s) :
    (levelRateSet r t).Nonempty := by
  obtain ⟨R, a, b, h, hgap, hR⟩ :=
    levelRateSet_nonempty_of_interior r hs hs'
