theorem raiseWeight_raiseWeight_comm
    {r : ℕ} (lam : Fin (r + 1) → ℕ)
    (i j : Fin (r + 1)) (hij : i ≠ j) :
    raiseWeight (raiseWeight lam i) j =
      raiseWeight (raiseWeight lam j) i := by
  funext a
  by_cases hai : a = i
  · subst a
    simp [raiseWeight, hij, Ne.symm hij]
  · by_cases haj : a = j
    · subst a
      simp [raiseWeight, hij, Ne.symm hij]
    · simp [raiseWeight, hai, haj]

end ArbitraryRowSameAxisDiamond

