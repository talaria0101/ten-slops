    (hrow : ∀ j, M (Fin.last r) j = if j = Fin.last r then 1 else 0) :
    (M.updateCol (Fin.last r) v).det = v (Fin.last r) * M.det :=
  det_updateCol_of_row_delta M (Fin.last r) v hrow

