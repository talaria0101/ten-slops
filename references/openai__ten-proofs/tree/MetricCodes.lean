attribute [local instance 100] LieRing.ofAssociativeRing

instance rootVectorLieRing (r : ℕ) : LieRing (RootVector r) where
  bracket := rootVectorBracket
  add_lie := rootVectorBracket_add_left
  lie_add := rootVectorBracket_add_right
  lie_self x := by
    apply rootAction_injective (r := r) (n := 1) (by decide)
    rw [rootAction_rootVectorBracket, map_zero]
    module
  leibniz_lie x y z := by
    apply rootAction_injective (r := r) (n := 1) (by decide)
    simp only [rootAction_rootVectorBracket, map_add]
    apply LinearMap.ext
    intro p
    simp only [LinearMap.sub_apply, LinearMap.comp_apply,
      LinearMap.add_apply, map_sub]
    abel

instance rootVectorLieAlgebra (r : ℕ) : LieAlgebra ℝ (RootVector r) where
  lie_smul t x y := by
    apply rootAction_injective (r := r) (n := 1) (by decide)
    change rootAction 1 (rootVectorBracket x (t • y)) =
      rootAction 1 (t • rootVectorBracket x y)
    rw [rootAction_rootVectorBracket, map_smul, map_smul,
      rootAction_rootVectorBracket]
    apply LinearMap.ext
    intro p
    simp only [LinearMap.sub_apply, LinearMap.comp_apply,
      LinearMap.smul_apply, map_smul, smul_sub]

instance rootVectorPolynomialLieRingModule (r n : ℕ) :
    LieRingModule (RootVector r) (PolynomialSpace r n) where
  bracket x p := rootAction n x p
  add_lie x y p := by
    change rootAction n (x + y) p =
      rootAction n x p + rootAction n y p
    simp
  lie_add x p q := by
    change rootAction n x (p + q) =
      rootAction n x p + rootAction n x q
    simp
  leibniz_lie x y p := by
    change rootAction n x (rootAction n y p) =
      rootAction n (rootVectorBracket x y) p +
        rootAction n y (rootAction n x p)
    rw [rootAction_rootVectorBracket]
    simp

instance rootVectorPolynomialLieModule (r n : ℕ) :
    LieModule ℝ (RootVector r) (PolynomialSpace r n) where
  smul_lie t x p := by
    change rootAction n (t • x) p = t • rootAction n x p
    simp
  lie_smul t x p := by
    change rootAction n x (t • p) = t • rootAction n x p
    simp

end

