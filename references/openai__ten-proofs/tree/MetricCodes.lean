  weyl_dimension_eq_finrank_harmonicYoung_of_rootExact hn lam
    (weightedChevalleyEilenbergDifferential n lam) hexact hzero

theorem weyl_dimension_eq_finrank_harmonicYoung_of_chevalleyExactness
