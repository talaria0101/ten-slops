  have hβ : P * Cβ = Cβ * P :=
    fullRootExteriorPolynomialAction_contraction_commute δ β
  have hα : P * Cα = Cα * P :=
    fullRootExteriorPolynomialAction_contraction_commute δ α
  change P * (E * (Cβ * Cα)) = (E * (Cβ * Cα)) * P
