def transverseGramIdeal (n : ℕ) : Ideal (PolynomialSpace 1 n) :=
  Ideal.span ({rowPairingPolynomial (r := 1) (n := n) 0 0,
    rowPairingPolynomial (r := 1) (n := n) 0 1} :
      Set (PolynomialSpace 1 n))

theorem transverseGramIdeal_ne_top (n : ℕ) :
    transverseGramIdeal n ≠ ⊤ := by
  let e : PolynomialSpace 1 n →+* ℝ :=
    MvPolynomial.eval (fun _ => 0)
  have hle : transverseGramIdeal n ≤ RingHom.ker e := by
    apply Ideal.span_le.mpr
    rintro p (rfl | rfl)
    · simp [e, rowPairingPolynomial]
    · simp [e, rowPairingPolynomial]
  intro htop
  have hone : (1 : PolynomialSpace 1 n) ∈ transverseGramIdeal n := by
    rw [htop]
    trivial
  have he := hle hone
  change e 1 = 0 at he
  norm_num at he

noncomputable instance transverseGramQuotient_nontrivial (n : ℕ) :
    Nontrivial ((PolynomialSpace 1 n) ⧸ transverseGramIdeal n) :=
  Ideal.Quotient.nontrivial_iff.mpr (transverseGramIdeal_ne_top n)

