    at hfirst
  have hsecond := LinearMap.congr_fun
    (rootJointHarmonicPolynomialInclusion_chevalley_intertwines
      (n := n) (k := k + 1) lam) f
  change
    rootJointHarmonicPolynomialInclusion n lam (k + 1)
