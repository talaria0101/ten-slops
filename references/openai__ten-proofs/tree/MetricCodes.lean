    · have hins : ¬∀ i,
          0 ≤ signedRootWeight lam (insert α S.val.val) i := by
        simpa [rootAdmissibleInsert_nonnegative_iff_second_pos lam S α hα]
          using hpos
      simp [rootPolynomialActionDifferentialCoboundaryIncidence,
        hα, hins, hpos]

