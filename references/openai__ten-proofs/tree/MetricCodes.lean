      ∑ α : PositiveRoot r,
        if hα : α ∈ S.val.val then
          ∑ β : PositiveRoot r,
            if hβ : β ∈ S.val.val then 0
            else if hadm : ∀ i,
                0 ≤ signedRootWeight lam (insert β (S.val.val.erase α)) i then
              ∑ γ : PositiveRoot r,
                if hγ : rootStructureConstant β γ α = 0 then 0
