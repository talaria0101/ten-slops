    [FiniteDimensional ℝ H]
    (U : ι → Submodule ℝ H) (V : κ → Submodule ℝ H)
    (hU : ∀ i j : ι, i ≠ j → U i ⟂ U j)
    (hV : ∀ i j : κ, i ≠ j → V i ⟂ V j)
