        youngGramRadialIdeal r n := by
  rw [Ideal.map_le_iff_le_comap, youngGramRadialIdeal,
    Ideal.span_le]
  rintro _ ⟨⟨i, j⟩, rfl⟩
  exact axialTransverseRetraction_rowPairingPolynomial_mem i j

