        ((n * Module.finrank ℝ
          (HarmonicYoungSpace (n := n) lam) : ℕ) : ℝ) := by
    push_cast
    convert h using 1
    · apply congrArg₂ (· + ·)
      · apply Finset.sum_congr rfl
        intro i _
        exact (weyl_dimension_eq_finrank_harmonicYoung hn
          (raiseWeight lam i.val) i.property).symm
      · apply Finset.sum_congr rfl
