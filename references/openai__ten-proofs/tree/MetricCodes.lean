theorem rootPolynomialActionDifferentialCoboundaryIncidence_swap
    {r n k : ℕ} (lam : Fin (r + 1) → ℕ)
    (f : RootJointHarmonicChain n lam (k + 1))
    (S : AdmissibleRootWedge lam (k + 1))
    (α β : PositiveRoot r) (hα : α ∈ S.val.val) (hβ : β ∉ S.val.val)
